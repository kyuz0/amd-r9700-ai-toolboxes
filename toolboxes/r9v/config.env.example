# Trusted shell file: copy and select with R9V_CONFIG_FILE=/absolute/path.
R9V_IMAGE=docker.io/kyuz0/amd-r9700-toolboxes:r9v-rocm-10.0
R9V_CONTAINER_NAME=r9700-r9v
R9V_MODEL_DIR="$HOME/models/R9V-Qwen3.8-IQ4_XS"
R9V_PLE_PATH="$HOME/r9v-data/per_layer_token_embd.iq4_nl.bin"
R9V_CACHE_DIR="$HOME/r9v-data/cache-toolbox-rocm10"
R9V_HOST_PORT=8004
R9V_VISIBLE_DEVICES=0,1
# Defaults below reproduce the recorded synchronous MTP2 panel.
R9V_PLE_RESIDENCY_MODE=ssd
R9V_PLE_WORKER_TIMING=1
R9V_MAX_MODEL_LEN=131072
R9V_MAX_NUM_SEQS=1
R9V_MAX_NUM_BATCHED_TOKENS=1024
R9V_KV_CACHE_MEMORY_BYTES=2285670400
R9V_CPU_OFFLOAD_GB=112.5
R9V_CPU_OFFLOAD_GB_BY_DEVICE=112.5,112.5
R9V_MTP_SPEC_TOKENS=2
